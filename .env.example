# God Seven Line — variáveis de ambiente lidas pelo build (scripts/build.js).
# Na Vercel: Project Settings → Environment Variables. No computador: ver docs/SETUP.md.
# Para usar localmente, copia para .env (ignorado pelo git) e corre: node --env-file=.env scripts/build.js
# Sem SUPABASE_URL e SUPABASE_ANON_KEY o site funciona em modo local (catálogo de data/products.json).
# Também são aceites os nomes do exemplo do Supabase: NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.

# URL do projeto Supabase (Project Settings → Data API, ou botão Connect), ex.: https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Chave pública: publishable key (sb_publishable_…) ou a antiga anon public (eyJ…) — Project Settings → API Keys.
# NUNCA colocar aqui a service_role nem a secret key (sb_secret_…): esta chave vai para o browser.
SUPABASE_ANON_KEY=

# Opcional: número WhatsApp que recebe os pedidos, só dígitos e com indicativo (formato: 258XXXXXXXXX).
# Vazio = usa whatsappNumber de config/site.js (258870204282).
WHATSAPP_NUMBER=

# Só para testes — NÃO definir na Vercel. Com o Supabase configurado mas inacessível (chave errada, schema.sql
# por correr, sem resposta em 15 s) o build falha, para a Vercel manter o último deploy bom.
# ALLOW_LOCAL_FALLBACK=1 gera mesmo assim, com as páginas estáticas feitas a partir de data/products.json.
ALLOW_LOCAL_FALLBACK=
